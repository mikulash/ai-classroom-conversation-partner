  "info": {
    "title": "AI Classroom Conversation Partner API",
    "description": "NestJS powered API with OpenAPI documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "student@example.edu"
          },
          "password": {
            "type": "string",
            "example": "strong-password"
          },
          "fullName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "gender": {
            "type": "string",
            "example": "female"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "gender"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "student@example.edu"
          },
          "password": {
            "type": "string",
            "example": "strong-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdatePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "student@example.edu"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "student@example.edu"
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "object"
          },
          "gender": {
            "type": "object"
          },
          "conversationRole": {
            "type": "string"
          },
          "bio": {
            "type": "object"
          }
        }
      },
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {
          "userRole": {
            "type": "string",
            "enum": [
              "basic",
              "admin",
              "owner"
            ]
          }
        }
      }
    }
  }
}