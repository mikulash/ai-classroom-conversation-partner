OPENAI_API_KEY=openai-key
ELEVENLABS_API_KEY=elevenlabs-key
GROK_API_KEY=grok-key
CLAUDE_API_KEY=claude-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_classroom

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

ELEVENLABS_FALLBACK_VOICE_ID_FEMALE=elevenlabs
ELEVENLABS_FALLBACK_VOICE_ID_MALE=elevenlabs

APP_FRONTEND_URL=http://localhost:5173# default development
AVATAR_UPLOAD_DIR=../../.data/avatar-uploads

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="no-reply@aifigurant.local"

#   0 2 * * * - Run at 2:00 AM every day (default)
TOKEN_CLEANUP_SCHEDULE="0 2 * * *"
