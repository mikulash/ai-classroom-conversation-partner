// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  basic
  admin
  owner
}

// Conversation type enum
enum ConversationType {
  VoiceOnly
  Video
  TextOnly
  TextWithAudio
}

// Model provider enums
enum ResponseModelProvider {
  OpenAi
  xAi
  Anthropic
}

enum TtsModelProvider {
  OpenAi
  ElevenLabs
}

enum RealtimeModelProvider {
  OpenAi
}

enum TranscriptionModelProvider {
  OpenAi
}

// Gender enum
enum Gender {
  M
  F
}

// OpenAI voice names
enum OpenAiVoice {
  alloy
  ash
  ballad
  coral
  echo
  fable
  onyx
  nova
  sage
  shimmer
  verse
}

// ============================================
// Core User Management
// ============================================

model Profile {
  id                String    @id @default(uuid())
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  email             String    @unique
  password          String    // bcrypt hashed password
  fullName          String?   @map("full_name")
  gender            String?
  conversationRole  String?   @map("conversation_role")
  bio               String?
  userRole          UserRole  @default(basic) @map("user_role")

  // Relations
  conversations                  Conversation[]
  adminCustomModelSelection      AdminUserCustomModelSelection?

  @@map("profiles")
}

model AdminUserCustomModelSelection {
  userId                              String    @id @map("user_id")
  createdAt                           DateTime  @default(now()) @map("created_at")
  responseModelId                     Int?      @map("response_model_id")
  ttsModelId                          Int?      @map("tts_model_id")
  realtimeModelId                     Int?      @map("realtime_model_id")
  realtimeTranscriptionModelId        Int?      @map("realtime_transcription_model_id")
  timestampedTranscriptionModelId     Int?      @map("timestamped_transcription_model_id")

  // Relations
  profile                             Profile                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseModel                       ResponseModel?                  @relation(fields: [responseModelId], references: [id])
  ttsModel                            TtsModel?                       @relation(fields: [ttsModelId], references: [id])
  realtimeModel                       RealtimeModel?                  @relation(fields: [realtimeModelId], references: [id])
  realtimeTranscriptionModel          RealtimeTranscriptionModel?     @relation(fields: [realtimeTranscriptionModelId], references: [id])
  timestampedTranscriptionModel       TimestampedTranscriptionModel?  @relation(fields: [timestampedTranscriptionModelId], references: [id])

  @@map("admin_users_custom_model_selection")
}

// ============================================
// Content Management
// ============================================

model Personality {
  id                        Int       @id @default(autoincrement())
  createdAt                 DateTime  @default(now()) @map("created_at")
  name                      String
  age                       Int?
  avatarUrl                 String?   @map("avatar_url")
  gender                    String?
  sex                       Gender?
  voiceInstructions         String?   @map("voice_instructions")
  elevenlabsVoiceId         String?   @map("elevenlabs_voice_id")
  openaiVoiceName           OpenAiVoice? @map("openai_voice_name")
  problemSummaryEn          String?   @map("problem_summary_en")
  personalityDescriptionEn  String?   @map("personality_description_en")
  problemSummaryCz          String?   @map("problem_summary_cs")
  personalityDescriptionCz  String?   @map("personality_description_cs")
  settingEn                 String?   @map("setting_en")
  settingCz                 String?   @map("setting_cs")
  isHidden                  Boolean   @default(false) @map("is_hidden")

  // Relations
  scenarios                 Scenario[]
  conversations             Conversation[]

  @@map("personalities")
}

model Scenario {
  id                        Int       @id @default(autoincrement())
  createdAt                 DateTime  @default(now()) @map("created_at")
  involvedPersonalityId     Int       @map("involved_personality_id")
  situationDescriptionEn    String?   @map("situation_description_en")
  settingEn                 String?   @map("setting_en")
  situationDescriptionCz    String?   @map("situation_description_cs")
  settingCz                 String?   @map("setting_cs")

  // Relations
  personality               Personality @relation(fields: [involvedPersonalityId], references: [id], onDelete: Cascade)
  conversations             Conversation[]

  @@map("scenarios")
}

model ConversationRole {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  nameEn    String   @map("name_en")
  nameCz    String   @map("name_cs")

  @@map("conversation_roles")
}

// ============================================
// Conversation Data
// ============================================

model Conversation {
  id                Int               @id @default(autoincrement())
  createdAt         DateTime          @default(now()) @map("created_at")
  userId            String            @map("user_id")
  personalityId     Int               @map("personality_id")
  scenarioId        Int?              @map("scenario_id")
  startTime         DateTime          @map("start_time")
  endTime           DateTime?         @map("end_time")
  endedReason       String?           @map("ended_reason")
  messages          Json?             // JSONB array of messages
  logs              Json?             // JSONB array of logs
  conversationType  ConversationType  @map("conversation_type")
  usedConfig        Json?             @map("used_config")

  // Relations
  user              Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality       Personality       @relation(fields: [personalityId], references: [id])
  scenario          Scenario?         @relation(fields: [scenarioId], references: [id])

  @@map("conversations")
}

// ============================================
// Model Management
// ============================================

model ResponseModel {
  id            Int                   @id @default(autoincrement())
  createdAt     DateTime              @default(now()) @map("created_at")
  friendlyName  String                @map("friendly_name")
  apiName       String                @map("api_name")
  docsUrl       String?               @map("docs_url")
  isEnabled     Boolean               @default(true) @map("is_enabled")
  provider      ResponseModelProvider

  // Relations
  adminSelections           AdminUserCustomModelSelection[]
  appConfigAsResponseModel  AppConfig[]

  @@map("response_models")
}

model TtsModel {
  id                                  Int               @id @default(autoincrement())
  createdAt                           DateTime          @default(now()) @map("created_at")
  friendlyName                        String            @map("friendly_name")
  apiName                             String            @map("api_name")
  sampleRate                          Int?              @map("sample_rate")
  docsUrl                             String?           @map("docs_url")
  isEnabled                           Boolean           @default(true) @map("is_enabled")
  provider                            TtsModelProvider
  allowsWordLevelTimestampedTranscript Boolean          @default(false) @map("allows_word_level_timestamped_transcript")

  // Relations
  adminSelections                     AdminUserCustomModelSelection[]
  appConfigAsTtsModel                 AppConfig[]

  @@map("tts_models")
}

model RealtimeModel {
  id            Int                     @id @default(autoincrement())
  createdAt     DateTime                @default(now()) @map("created_at")
  friendlyName  String                  @map("friendly_name")
  apiName       String                  @map("api_name")
  docsUrl       String?                 @map("docs_url")
  isEnabled     Boolean                 @default(true) @map("is_enabled")
  provider      RealtimeModelProvider

  // Relations
  adminSelections               AdminUserCustomModelSelection[]
  appConfigAsRealtimeModel      AppConfig[]

  @@map("realtime_models")
}

model RealtimeTranscriptionModel {
  id                        Int                           @id @default(autoincrement())
  createdAt                 DateTime                      @default(now()) @map("created_at")
  friendlyName              String                        @map("friendly_name")
  provider                  TranscriptionModelProvider
  apiName                   String                        @map("api_name")
  docsUrl                   String?                       @map("docs_url")
  isEnabled                 Boolean                       @default(true) @map("is_enabled")
  allowsWordLevelTimestamps Boolean                       @default(false) @map("allows_word_level_timestamps")

  // Relations
  adminSelections                           AdminUserCustomModelSelection[]
  appConfigAsRealtimeTranscriptionModel     AppConfig[]

  @@map("realtime_transcription_models")
}

model TimestampedTranscriptionModel {
  id            Int                           @id @default(autoincrement())
  createdAt     DateTime                      @default(now()) @map("created_at")
  friendlyName  String                        @map("friendly_name")
  provider      TranscriptionModelProvider
  apiName       String                        @map("api_name")
  docsUrl       String?                       @map("docs_url")
  isEnabled     Boolean                       @default(true) @map("is_enabled")

  // Relations
  adminSelections                               AdminUserCustomModelSelection[]
  appConfigAsTimestampedTranscriptionModel      AppConfig[]

  @@map("timestamped_transcription_models")
}

// ============================================
// Configuration
// ============================================

model AppConfig {
  id                                  Int       @id @default(autoincrement())
  editedAt                            DateTime  @default(now()) @updatedAt @map("edited_at")
  responseModelId                     Int?      @map("response_model_id")
  ttsModelId                          Int?      @map("tts_model_id")
  realtimeModelId                     Int?      @map("realtime_model_id")
  silenceTimeoutInSeconds             Int       @default(30) @map("silence_timeout_in_seconds")
  allowedDomains                      String[]  @map("allowed_domains")
  appName                             String    @default("AI FIGURANT") @map("app_name")
  realtimeTranscriptionModelId        Int?      @map("realtime_transcription_model_id")
  timestampedTranscriptionModelId     Int?      @map("timestamped_transcription_model_id")
  maxConversationDurationInSeconds    Int       @default(300) @map("max_conversation_duration_in_seconds")

  // Relations
  responseModel                     ResponseModel?                  @relation(fields: [responseModelId], references: [id])
  ttsModel                          TtsModel?                       @relation(fields: [ttsModelId], references: [id])
  realtimeModel                     RealtimeModel?                  @relation(fields: [realtimeModelId], references: [id])
  realtimeTranscriptionModel        RealtimeTranscriptionModel?     @relation(fields: [realtimeTranscriptionModelId], references: [id])
  timestampedTranscriptionModel     TimestampedTranscriptionModel?  @relation(fields: [timestampedTranscriptionModelId], references: [id])

  @@map("app_config")
}
