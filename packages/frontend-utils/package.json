{
  "name": "@repo/frontend-utils",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": "./*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "dev": "tsc -b --watch",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate-openapi": "openapi-generator-cli generate -i ../../apps/backend/openapi.json -g typescript-axios -o ./src/clients/generated"
  },
  "dependencies": {
    "@repo/shared": "workspace:*",
    "axios": "1.12.0",
    "i18next": "^25.1.2",
    "react-i18next": "^15.5.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
