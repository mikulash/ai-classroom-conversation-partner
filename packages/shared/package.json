{
  "name": "@repo/shared",
  "version": "1.0.0",
  "description": "Common TypeScript types and enums for the project",
  "exports": {
    "./enums/*": "./dist/enums/*.js",
    "./types/*": "./dist/types/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./mappers/*": "./dist/mappers/*.js"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "dev": "tsc -b --watch",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.6",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
