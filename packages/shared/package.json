{
  "name": "@repo/shared",
  "version": "1.0.0",
  "description": "Common TypeScript types and enums for the project",
  "exports": {
    "./enums/*": {
      "types": "./src/enums/*.ts",
      "default": "./dist/enums/*.js"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "./mappers/*": {
      "types": "./src/mappers/*.ts",
      "default": "./dist/mappers/*.js"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "dev": "tsc -b --watch",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.6",
    "eslint": "^9.25.0",
    "typescript": "^5.9.3"
  }
}
