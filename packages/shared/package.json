{
  "name": "@repo/shared",
  "version": "1.0.0",
  "description": "Common TypeScript types and enums for the project",
  "exports": {
    "./enums/*": {
      "import": "./dist/enums/*.js",
      "types": "./dist/enums/*.d.ts"
    },
    "./types/*": {
      "import": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    },
    "./generated/*": {
      "import": "./dist/generated/*.js",
      "types": "./dist/generated/*.d.ts"
    },
    "./prisma/*": {
      "import": "./dist/prisma/*.js",
      "types": "./dist/prisma/*.d.ts"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "dev": "tsc -b --watch",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push --force-reset",
    "db:seed": "prisma db seed",
    "migrate:supabase": "tsx scripts/migrate-from-supabase.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.18.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^9.25.0",
    "@types/node": "^22.15.6",
    "prisma": "^6.18.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  }
}
