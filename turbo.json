{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "prisma:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "prisma:generate",
        "^prisma:generate",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "PORT",
        "OPENAI_API_KEY",
        "ELEVENLABS_API_KEY",
        "GROK_API_KEY",
        "CLAUDE_API_KEY",
        "TAURI_DEV_HOST",
        "VITE_BACKEND_URL",
        "ELEVENLABS_FALLBACK_VOICE_ID_FEMALE",
        "ELEVENLABS_FALLBACK_VOICE_ID_MALE",
        "MODE",
        "NODE_ENV",
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRES_IN",
        "APP_BASE_URL",
        "APP_FRONTEND_URL",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "MAIL_FROM",
        "TOKEN_CLEANUP_SCHEDULE"
      ]
    },
    "start": {
      "dependsOn": [
        "^start"
      ],
      "persistent": true,
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "lint": {
      "dependsOn": [
        "prisma:generate",
        "^prisma:generate",
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "prisma:generate",
        "^prisma:generate",
        "^typecheck"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "prisma:generate",
        "^prisma:generate",
        "^dev"
      ],
      "persistent": true,
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "PORT",
        "OPENAI_API_KEY",
        "ELEVENLABS_API_KEY",
        "GROK_API_KEY",
        "CLAUDE_API_KEY",
        "TAURI_DEV_HOST",
        "VITE_BACKEND_URL",
        "ELEVENLABS_FALLBACK_VOICE_ID_FEMALE",
        "ELEVENLABS_FALLBACK_VOICE_ID_MALE",
        "MODE",
        "NODE_ENV",
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_EXPIRES_IN",
        "APP_BASE_URL",
        "APP_FRONTEND_URL",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "MAIL_FROM",
        "TOKEN_CLEANUP_SCHEDULE"
      ]
    }
  }
}
